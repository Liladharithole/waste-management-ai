PORT=7001 or your port number
NODE_ENV=development or your node environment
LOG_LEVEL=debug or your log level

# Frontend URL(s) for CORS — e.g. Next.js on port 3000
CORS_ORIGIN=http://localhost:3000 or your frontend url

# Optional — preflight cache (seconds). Omit for default 600.
CORS_MAX_AGE=600 or your cors max age

# MySQL Host
MYSQL_ROOT_PASSWORD=root@1234 or your mysql root password
MYSQL_USER=root or your mysql user name
MYSQL_PASSWORD=root@1234 or your mysql user password
DB_PORT=3306 or your mysql port number

# Main Application Database Connection URLs (waste_management)
# Note: %40 is URL encoding for @ in root@1234 password
DATABASE_URL="mysql://root:root%401234@localhost:3306/waste_management" or your mysql database url
DATABASE_READ_URL="mysql://root:root%401234@localhost:3306/waste_management" or your mysql read database url

# Central Core Database Connection URLs (central_core_db)
CENTRAL_CORE_DATABASE_URL="mysql://root:root%401234@localhost:3306/central_core_db" or your central core database url
CENTRAL_CORE_DATABASE_READ_URL="mysql://root:root%401234@localhost:3306/central_core_db" or your central core read database url

# Redis Host
REDIS_HOST=localhost or your redis host
REDIS_PORT=6379 or your redis port number
REDIS_TTL=300000 or your redis ttl

# JWT Configurations
JWT_SECRET="your secret key"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Google Maps API Key
GOOGLE_MAPS_API_KEY="your google maps api key"

# Throttler Configurations
THROTTLE_TTL=60000 or your throttle ttl
THROTTLE_LIMIT=100 or your throttle limit

# Cron Security Secret Key
CRON_SECRET_KEY="super-secret-cron-key-2026" or your cron secret key