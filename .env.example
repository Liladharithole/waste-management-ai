PORT=7001
NODE_ENV=development
LOG_LEVEL=debug

# Frontend URL(s) for CORS — e.g. Next.js on port 3000
CORS_ORIGIN=http://localhost:3000

# Optional — preflight cache (seconds). Omit for default 600.
# CORS_MAX_AGE=600

# MySQL Container Credentials
MYSQL_ROOT_PASSWORD=root@1234
MYSQL_USER=root
MYSQL_PASSWORD=root@1234
DB_PORT=3306

# Main Application Database Connection URLs (waste_management)
DATABASE_URL="mysql://${MYSQL_USER}:${MYSQL_PASSWORD}@localhost:${DB_PORT}/waste_management"
DATABASE_READ_URL="mysql://${MYSQL_USER}:${MYSQL_PASSWORD}@localhost:${DB_PORT}/waste_management"

# Central Core Database Connection URLs (central_core_db)
CENTRAL_CORE_DATABASE_URL="mysql://${MYSQL_USER}:${MYSQL_PASSWORD}@localhost:${DB_PORT}/central_core_db"
CENTRAL_CORE_DATABASE_READ_URL="mysql://${MYSQL_USER}:${MYSQL_PASSWORD}@localhost:${DB_PORT}/central_core_db"
