PORT=7001
NODE_ENV=development
LOG_LEVEL=debug

# Frontend URL(s) for CORS — e.g. Next.js on port 3000
CORS_ORIGIN=http://localhost:3000

# preflight cache (seconds) default 600.
CORS_MAX_AGE=600

# MySQL Container Credentials
MYSQL_ROOT_PASSWORD=root@1234
MYSQL_USER=root
MYSQL_PASSWORD=root@1234
DB_PORT=3306

# Main Application Database Connection URLs (waste_management)
DATABASE_URL="mysql://root:root%401234@localhost:3306/waste_management"
DATABASE_READ_URL="mysql://root:root%401234@localhost:3306/waste_management"

# Central Core Database Connection URLs (central_core_db)
CENTRAL_CORE_DATABASE_URL="mysql://root:root%401234@localhost:3306/central_core_db"
CENTRAL_CORE_DATABASE_READ_URL="mysql://root:root%401234@localhost:3306/central_core_db"

# Redis Cache Configurations
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TTL=300000

# JWT Configurations
JWT_SECRET="4a7e289bf65d83c0d12e6bf5632a9cd1038db4e815612fb8f3a53c9e62f01a3c"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Google Maps API Key
GOOGLE_MAPS_API_KEY=""

# Throttler Configurations
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Cron Security Secret Key
CRON_SECRET_KEY="super-secret-cron-key-2026"

# AWS S3 Storage Configurations
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
AWS_S3_BUCKET_NAME="waste-management-ai-bucket"
AWS_S3_PRESIGNED_EXPIRY_SECONDS=900

# SMTP Email Server Configurations
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM='"Waste Management AI" <noreply@wastemanagement.ai>'