PORT=7001
NODE_ENV=development
LOG_LEVEL=debug

# Frontend URL(s) for CORS — e.g. Next.js on port 3000
CORS_ORIGIN=http://localhost:3000

# Optional — preflight cache (seconds). Omit for default 600.
# CORS_MAX_AGE=600

# MySQL Container Credentials
MYSQL_ROOT_PASSWORD=root@1234
MYSQL_USER=root
MYSQL_PASSWORD=root@1234
DB_PORT=3306

# Main Application Database Connection URLs (waste_management)
# Note: %40 is URL encoding for @ in root@1234 password
DATABASE_URL="mysql://root:root%401234@localhost:3306/waste_management"
DATABASE_READ_URL="mysql://root:root%401234@localhost:3306/waste_management"

# Central Core Database Connection URLs (central_core_db)
CENTRAL_CORE_DATABASE_URL="mysql://root:root%401234@localhost:3306/central_core_db"
CENTRAL_CORE_DATABASE_READ_URL="mysql://root:root%401234@localhost:3306/central_core_db"
