PORT=7001
NODE_ENV=development
LOG_LEVEL=debug

# Frontend URL(s) for CORS — e.g. Next.js on port 3000
CORS_ORIGIN=http://localhost:3000

# Optional — preflight cache (seconds). Omit for default 600.
CORS_MAX_AGE=600

DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/waste_management"
DATABASE_READ_URL="mysql://USER:PASSWORD@localhost:3306/waste_management"

CENTRAL_CORE_DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/central_core_db"
CENTRAL_CORE_DATABASE_READ_URL="mysql://USER:PASSWORD@localhost:3306/central_core_db"
