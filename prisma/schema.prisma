generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model WasteCategory {
  id          Int               @id @default(autoincrement())
  uuid        String            @unique @default(uuid()) @map("uuid")
  name        String            @unique @map("name")
  description String?           @map("description")
  
  // Audit columns
  createdAt   DateTime          @default(now()) @map("created_at")
  createdBy   String?           @map("created_by")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  updatedBy   String?           @map("updated_by")
  deletedAt   DateTime?         @map("deleted_at")
  deletedBy   String?           @map("deleted_by")

  // Relations
  collections WasteCollection[]

  @@map("waste_categories")
}

model WasteCollection {
  id              Int           @id @default(autoincrement())
  uuid            String        @unique @default(uuid()) @map("uuid")
  
  // References to central_core_db User.id (Option 1 Cross-DB joins)
  collectorUserId Int           @map("collector_user_id")
  residentUserId  Int           @map("resident_user_id")
  
  collectionDate  DateTime      @default(now()) @map("collection_date")
  wasteCategoryId Int           @map("waste_category_id")
  wasteCategory   WasteCategory @relation(fields: [wasteCategoryId], references: [id], onDelete: Restrict)
  
  weight          Float         @map("weight")
  photoUrl        String?       @map("photo_url")
  remarks         String?       @map("remarks")
  isCollected     Boolean       @default(false) @map("is_collected")

  // Audit columns
  createdAt       DateTime      @default(now()) @map("created_at")
  createdBy       String?       @map("created_by")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  updatedBy       String?       @map("updated_by")
  deletedAt       DateTime?     @map("deleted_at")
  deletedBy       String?       @map("deleted_by")

  @@index([wasteCategoryId])
  @@index([collectorUserId])
  @@index([residentUserId])
  @@map("waste_collections")
}
