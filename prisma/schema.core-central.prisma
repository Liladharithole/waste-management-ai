generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/client-central-core"
}

datasource db {
  provider = "mysql"
}

model User {
  id            Int               @id @default(autoincrement())
  uuid          String            @unique @default(uuid()) @map("uuid")
  email         String            @unique @map("email")
  passwordHash  String            @map("password_hash")
  firstName     String            @map("first_name")
  middleName    String?           @map("middle_name")
  lastName      String            @map("last_name")
  status        String            @default("ACTIVE") @map("status")
  
  // Audit columns
  createdAt     DateTime          @default(now()) @map("created_at")
  createdBy     String?           @map("created_by")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  updatedBy     String?           @map("updated_by")
  deletedAt     DateTime?         @map("deleted_at")
  deletedBy     String?           @map("deleted_by")

  // Relations
  userRoles     UserRole[]
  userProfile   UserProfile?
  addresses     UserAddress[]
  refreshTokens RefreshToken[]
  notifications NotificationLog[]
  resident      Resident?
  employee      Employee?

  @@index([status])
  @@map("users")
}

model Role {
  id              Int              @id @default(autoincrement())
  uuid            String           @unique @default(uuid()) @map("uuid")
  name            String           @unique @map("name")
  description     String?          @map("description")
  
  // Audit columns
  createdAt       DateTime         @default(now()) @map("created_at")
  createdBy       String?          @map("created_by")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  updatedBy       String?          @map("updated_by")
  deletedAt       DateTime?        @map("deleted_at")
  deletedBy       String?          @map("deleted_by")

  // Relations
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model UserRole {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique @default(uuid()) @map("uuid")
  userId    Int      @map("user_id")
  roleId    Int      @map("role_id")
  
  // Audit columns
  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  // Relations
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model UserProfile {
  id             Int       @id @default(autoincrement())
  uuid           String    @unique @default(uuid()) @map("uuid")
  userId         Int       @unique @map("user_id")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  gender         String?   @map("gender")
  phone          String?   @map("phone")
  alternatePhone String?   @map("alternate_phone")
  dateOfBirth    DateTime? @map("date_of_birth")
  avatarUrl      String?   @map("avatar_url")

  // Audit columns
  createdAt      DateTime  @default(now()) @map("created_at")
  createdBy      String?   @map("created_by")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  updatedBy      String?   @map("updated_by")
  deletedAt      DateTime? @map("deleted_at")
  deletedBy      String?   @map("deleted_by")

  @@index([userId])
  @@map("user_profiles")
}

model UserAddress {
  id           Int      @id @default(autoincrement())
  uuid         String   @unique @default(uuid()) @map("uuid")
  userId       Int      @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  addressLabel String?  @map("address_label")
  addressLine1 String   @map("address_line_1")
  addressLine2 String?  @map("address_line_2")
  city         String   @map("city")
  state        String   @map("state")
  postalCode   String   @map("postal_code")
  country      String   @default("India") @map("country")
  
  // Coordinates
  latitude     Float    @map("latitude")
  longitude    Float    @map("longitude")
  
  isDefault    Boolean  @default(false) @map("is_default")

  // Audit columns
  createdAt    DateTime @default(now()) @map("created_at")
  createdBy    String?  @map("created_by")
  updatedAt    DateTime @updatedAt @map("updated_at")
  updatedBy    String?  @map("updated_by")
  deletedAt    DateTime? @map("deleted_at")
  deletedBy    String?  @map("deleted_by")

  @@index([userId])
  @@map("user_addresses")
}

model RefreshToken {
  id         BigInt    @id @default(autoincrement())
  uuid       String    @unique @default(uuid()) @map("uuid")
  userId     Int       @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  token      String    @unique @map("token")
  deviceName String?   @map("device_name")
  ipAddress  String?   @map("ip_address")
  userAgent  String?   @db.Text @map("user_agent")
  expiresAt  DateTime  @map("expires_at")
  lastUsedAt DateTime  @default(now()) @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")

  // Audit columns
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("refresh_tokens")
}

model NotificationLog {
  id        Int       @id @default(autoincrement())
  uuid      String    @unique @default(uuid()) @map("uuid")
  userId    Int       @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title     String    @map("title")
  body      String    @map("body")
  type      String    @map("type")
  status    String    @default("SENT") @map("status")
  readAt    DateTime? @map("read_at")

  // Audit columns
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by")
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by")

  @@index([userId])
  @@map("notification_logs")
}

model Organization {
  id        Int                   @id @default(autoincrement())
  uuid      String                @unique @default(uuid()) @map("uuid")
  name      String                @unique @map("name")
  fullName  String                @map("full_name")
  shortName String                @map("short_name")
  type      String                @default("GOVERNMENT") @map("type")
  status    String                @default("ACTIVE") @map("status")
  
  // Audit columns
  createdAt DateTime              @default(now()) @map("created_at")
  createdBy String?               @map("created_by")
  updatedAt DateTime              @updatedAt @map("updated_at")
  updatedBy String?               @map("updated_by")
  deletedAt DateTime?             @map("deleted_at")
  deletedBy String?               @map("deleted_by")

  // Relations
  settings  OrganizationSettings?
  addresses OrganizationAddress[]
  sites     Site[]
  employees Employee[]

  @@map("organizations")
}

model OrganizationSettings {
  id             Int          @id @default(autoincrement())
  uuid           String       @unique @default(uuid()) @map("uuid")
  organizationId Int          @unique @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  theme          String       @default("light") @map("theme")
  timezone       String       @default("Asia/Kolkata") @map("timezone")
  language       String       @default("en") @map("language")

  // Audit columns
  createdAt      DateTime     @default(now()) @map("created_at")
  createdBy      String?      @map("created_by")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  updatedBy      String?      @map("updated_by")
  deletedAt      DateTime?    @map("deleted_at")
  deletedBy      String?      @map("deleted_by")

  @@map("organization_settings")
}

model OrganizationAddress {
  id             Int          @id @default(autoincrement())
  uuid           String       @unique @default(uuid()) @map("uuid")
  organizationId Int          @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  addressLabel   String?      @map("address_label")
  addressLine1   String       @map("address_line_1")
  addressLine2   String?      @map("address_line_2")
  city           String       @map("city")
  state          String       @map("state")
  postalCode     String       @map("postal_code")
  country        String       @default("India") @map("country")
  latitude       Float        @map("latitude")
  longitude      Float        @map("longitude")
  isDefault      Boolean      @default(false) @map("is_default")

  // Audit columns
  createdAt      DateTime     @default(now()) @map("created_at")
  createdBy      String?      @map("created_by")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  updatedBy      String?      @map("updated_by")
  deletedAt      DateTime?    @map("deleted_at")
  deletedBy      String?      @map("deleted_by")

  @@index([organizationId])
  @@map("organization_addresses")
}

model Site {
  id             Int          @id @default(autoincrement())
  uuid           String       @unique @default(uuid()) @map("uuid")
  organizationId Int          @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String       @map("name")
  
  // Address Fields
  addressLine1   String       @map("address_line_1")
  addressLine2   String?      @map("address_line_2")
  city           String       @map("city")
  state          String       @map("state")
  postalCode     String       @map("postal_code")
  country        String       @default("India") @map("country")
  latitude       Float        @map("latitude")
  longitude      Float        @map("longitude")

  // Audit columns
  createdAt      DateTime     @default(now()) @map("created_at")
  createdBy      String?      @map("created_by")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  updatedBy      String?      @map("updated_by")
  deletedAt      DateTime?    @map("deleted_at")
  deletedBy      String?      @map("deleted_by")

  // Relations
  buildings      Building[]

  @@index([organizationId])
  @@map("sites")
}

model Building {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique @default(uuid()) @map("uuid")
  siteId    Int      @map("site_id")
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name      String   @map("name")
  wing      String?  @map("wing")
  
  // Audit columns
  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?  @map("deleted_by")

  // Relations
  floors    Floor[]

  @@index([siteId])
  @@map("buildings")
}

model Floor {
  id          Int      @id @default(autoincrement())
  uuid        String   @unique @default(uuid()) @map("uuid")
  buildingId  Int      @map("building_id")
  building    Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  floorNumber Int      @map("floor_number")
  name        String?  @map("name")
  
  // Audit columns
  createdAt   DateTime @default(now()) @map("created_at")
  createdBy   String?  @map("created_by")
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedBy   String?  @map("updated_by")
  deletedAt   DateTime? @map("deleted_at")
  deletedBy   String?  @map("deleted_by")

  // Relations
  units       Unit[]

  @@index([buildingId])
  @@map("floors")
}

model Unit {
  id         Int       @id @default(autoincrement())
  uuid       String    @unique @default(uuid()) @map("uuid")
  floorId    Int       @map("floor_id")
  floor      Floor     @relation(fields: [floorId], references: [id], onDelete: Cascade)
  unitNumber String    @map("unit_number")
  
  // Audit columns
  createdAt  DateTime  @default(now()) @map("created_at")
  createdBy  String?   @map("created_by")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  updatedBy  String?   @map("updated_by")
  deletedAt  DateTime? @map("deleted_at")
  deletedBy  String?   @map("deleted_by")

  // Relations
  residents  Resident[]

  @@index([floorId])
  @@map("units")
}

model Resident {
  id        Int       @id @default(autoincrement())
  uuid      String    @unique @default(uuid()) @map("uuid")
  
  userId    Int       @unique @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  unitId    Int       @map("unit_id")
  unit      Unit      @relation(fields: [unitId], references: [id], onDelete: Restrict)

  // Audit columns
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by")
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by")

  @@index([unitId])
  @@map("residents")
}

model Employee {
  id             Int          @id @default(autoincrement())
  uuid           String       @unique @default(uuid()) @map("uuid")
  
  userId         Int          @unique @map("user_id")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  organizationId Int          @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  employeeCode   String?      @unique @map("employee_code")
  designation    String?      @map("designation")

  // Audit columns
  createdAt      DateTime     @default(now()) @map("created_at")
  createdBy      String?      @map("created_by")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  updatedBy      String?      @map("updated_by")
  deletedAt      DateTime?    @map("deleted_at")
  deletedBy      String?      @map("deleted_by")

  @@index([organizationId])
  @@map("employees")
}

model Permission {
  id              Int              @id @default(autoincrement())
  uuid            String           @unique @default(uuid()) @map("uuid")
  name            String           @unique @map("name")
  description     String?          @map("description")

  // Audit columns
  createdAt       DateTime         @default(now()) @map("created_at")
  createdBy       String?          @map("created_by")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  updatedBy       String?          @map("updated_by")
  deletedAt       DateTime?        @map("deleted_at")
  deletedBy       String?          @map("deleted_by")

  // Relations
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  uuid         String     @unique @default(uuid()) @map("uuid")
  
  roleId       Int        @map("role_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  
  permissionId Int        @map("permission_id")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  // Audit columns
  createdAt    DateTime   @default(now()) @map("created_at")
  createdBy    String?    @map("created_by")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  updatedBy    String?    @map("updated_by")

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}
